@using CCSentinelUI.Components.Authentication
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject CustomAuthStateProvider AuthStateProvider

<nav class="nav flex-column p-3">
    <NavLink class="nav-link text-white mb-2" href="/">Database Display</NavLink>
    <NavLink class="nav-link text-white mb-2" href="create">Create</NavLink>
    <NavLink class="nav-link text-white mb-2" href="weather">Weather</NavLink>
    <MudButton OnClick="@Logout" Color="Color.Error" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Logout">
        Logout
    </MudButton>
</nav>

@code {
    private async Task Logout()
    {
        await JS.InvokeVoidAsync("fetch", "/api/logout", new { method = "POST", credentials = "include" });
        await AuthStateProvider.MarkUserAsLoggedOut();
        Nav.NavigateTo("/login", true);
    }
}
