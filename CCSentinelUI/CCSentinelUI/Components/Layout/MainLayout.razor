@using CCSentinelUI.Components.Authentication
@inherits LayoutComponentBase
@inject CustomAuthStateProvider authStateProvider
@* Required *@
<MudThemeProvider />
<MudPopoverProvider />

@* Needed for dialogs *@
<MudDialogProvider />

@* Needed for snackbars *@
<MudSnackbarProvider />

<MudAppBar Style="background-color:#f58f25; position:relative;" Elevation="2">
    <div style="position:absolute; top:0; left:0; width:100px; height:64px; background-color:white; display:flex; align-items:center; justify-content:center;">
        <img src="images/CCLAW_logo2.jpg" style="max-width:80%; max-height:80%;" />
    </div>

    <MudSpacer />
    <MudButtonGroup>
        <MudIconButton Icon="@Icons.Custom.Brands.MicrosoftVisualStudio" href="https://visualstudio.microsoft.com/" Target="_blank" Color="Color.Inherit" />
        <MudIconButton Icon="@Icons.Custom.Brands.Microsoft" href="https://learn.microsoft.com/aspnet/core/" Target="_blank" Color="Color.Inherit" />
        <MudIconButton Icon="@Icons.Custom.Brands.MudBlazor" href="https://mudblazor.com/" Target="_blank" Color="Color.Inherit" />
    </MudButtonGroup>
</MudAppBar>

<div style="display:flex; flex-direction:column; height:100vh;">
    <div style="display:flex; flex:1; overflow:hidden;">
        <div style="width:240px; background-color:#f58f25; color:white; overflow:auto;">
            <NavMenu />
        </div>

        <main style="flex:1; overflow:auto; padding:16px; background-color:white;">
            @Body
        </main>
    </div>

    <footer style="height:64px; background-color:#5097a4; display:flex; align-items:center; justify-content:center;">
    </footer>
</div>


