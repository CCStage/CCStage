@using CCSentinelUI.Data.Contracts
@inject ApplicationDbContext Db
@inject ISnackbar Snackbar

<MudGrid Spacing="3">
    <MudItem xs="12">
        <MudText Typo="Typo.h6" Class="mb-2">Claims toevoegen</MudText>
    </MudItem>

    <MudItem xs="12">
        <MudTextField Label="Key"
                      @bind-Value="_claimKey"
                      FullWidth="true"
                      Required="true"
                      Immediate="true"
                      Error="@_claimKeyError"
                      ErrorText="Key moet een '_' of '-' bevatten."
                      OnInput="ValidateClaimKey"
                      OnBlur="ValidateClaimKey" />
    </MudItem>

    <MudItem xs="12">
        <MudTextField @bind-Value="_claimValue" Label="Value" FullWidth="true" Required="true" />
    </MudItem>

    <MudItem>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Class="mt-2"
                   OnClick="SaveClaim"
                   Disabled="@(_claimKeyError || string.IsNullOrWhiteSpace(_claimValue))">
            Claim opslaan
        </MudButton>
    </MudItem>

    <MudItem xs="12" Class="mt-6">
        <MudText Typo="Typo.h6">Bestaande claims</MudText>
    </MudItem>
    <MudItem xs="12">
        <MudTable Items="@_claims" Dense="true" Hover="true" Elevation="0">
            <HeaderContent>
                <MudTh>Key</MudTh>
                <MudTh>Value</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.ClaimType</MudTd>
                <MudTd>@context.ClaimValue</MudTd>
                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                   Color="Color.Error"
                                   OnClick="@(() => DeleteClaim(context.Id))" />
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText>Geen claims toegevoegd aan deze rol.</MudText>
            </NoRecordsContent>
        </MudTable>
    </MudItem>
</MudGrid>

@code {
    [Parameter] public Guid RoleId { get; set; }

    private string _claimKey = "";
    private string _claimValue = "";
    private List<SentinelRoleClaim> _claims = new();
    private bool _claimKeyError = false;

    protected override async Task OnParametersSetAsync()
    {
        if (RoleId != Guid.Empty)
        {
            _claims = await Db.Set<SentinelRoleClaim>()
                              .Where(c => c.RoleId == RoleId)
                              .ToListAsync();
        }
    }

    private void ValidateClaimKey()
    {
        _claimKeyError = string.IsNullOrWhiteSpace(_claimKey) || !(_claimKey.Contains("_") || _claimKey.Contains("-"));
    }

    private async Task SaveClaim()
    {
        ValidateClaimKey();
        if (_claimKeyError || string.IsNullOrWhiteSpace(_claimValue)) return;

        var claim = new SentinelRoleClaim
        {
            RoleId = RoleId,
            ClaimType = _claimKey,
            ClaimValue = _claimValue
        };

        Db.Set<SentinelRoleClaim>().Add(claim);
        await Db.SaveChangesAsync();

        _claims.Add(claim);
        _claimKey = "";
        _claimValue = "";
        _claimKeyError = false;
        Snackbar.Add("Claim opgeslagen", Severity.Success);
    }

    private async Task DeleteClaim(int claimId)
    {
        var claim = _claims.FirstOrDefault(c => c.Id == claimId);
        if (claim == null) return;

        Db.Set<SentinelRoleClaim>().Remove(claim);
        await Db.SaveChangesAsync();

        _claims.Remove(claim);
        Snackbar.Add("Claim verwijderd", Severity.Success);
    }
}
