@page "/edit-application/{ClientId}"
@using CCSentinelUI.Data
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext Db
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject ILogger<Login> Logger
@using MudBlazor

<MudPaper Class="p-4 mx-auto" MaxWidth="600px" Elevation="3">
    <MudText Typo="Typo.h5">Edit applicatie</MudText>
    <MudForm @ref="_form" Class="mt-4">
        <MudTextField Label="ClientId" @bind-Value="_model.ClientId" Disabled="true" />
        <MudTextField Label="Display Name" @bind-Value="_model.DisplayName" Required="true" />

        <MudText Typo="Typo.subtitle2" Class="mb-2">Endpoints</MudText>
        <MudCheckBox T="bool" @bind-Value="_endpoints.Token" Label="token" />
        <MudCheckBox T="bool" @bind-Value="_endpoints.Authorize" Label="authorize" />
        <MudCheckBox T="bool" @bind-Value="_endpoints.Introspect" Label="introspect" />
        <MudCheckBox T="bool" @bind-Value="_endpoints.Revocation" Label="revocation" />
        <MudCheckBox T="bool" @bind-Value="_endpoints.Logout" Label="logout" />
        <MudCheckBox T="bool" @bind-Value="_endpoints.UserInfo" Label="userinfo" />

        <MudText Typo="Typo.subtitle2" Class="mb-2">Grant Types</MudText>
        <MudCheckBox T="bool" @bind-Value="_permissions.AuthorizationCode" Label="authorization_code" />
        <MudCheckBox T="bool" @bind-Value="_permissions.RefreshToken" Label="refresh_token" />
        <MudCheckBox T="bool" @bind-Value="_permissions.ClientCredentials" Label="client_credentials" />

        <MudText Typo="Typo.subtitle2" Class="mb-2">Scopes</MudText>
        <MudSelect T="string"
                   Label="Selecteer scopes"
                   SelectedValues="_selectedScopeNames"
                   SelectedValuesChanged="values => _selectedScopeNames = values.ToList()"
                   MultiSelection="true"
                   Dense="true"
                   Chip="true">
            @foreach (var scope in _availableScopes)
            {
                <MudSelectItem Value="@scope.Name">@((scope.Name))</MudSelectItem>
            }
        </MudSelect>

        <MudTextField Label="RedirectUris" @bind-Value="_model.RedirectUris" />
        <MudSelect Label="ClientType" @bind-Value="_model.ClientType">
            @foreach (var type in _types)
            {
                <MudSelectItem Value="@type">@type</MudSelectItem>
            }
        </MudSelect>

        <input type="hidden" @bind="_model.Version" />
        <MudButton Color="Color.Primary" OnClick="Save" Class="mt-3">Opslaan</MudButton>
        <MudButton Color="Color.Secondary" OnClick="Cancel" Class="mt-3 ml-2">Annuleren</MudButton>
    </MudForm>
</MudPaper>

@code {
    private readonly string[] _types = { "confidental", "public" };
    [Parameter] public string ClientId { get; set; } = string.Empty;

    private MudForm? _form;
    private SentinelApplication _model = new();
    private List<OpenIddictEntityFrameworkCoreScope> _availableScopesBase = new();
    private List<SentinelScope> _availableScopes => _availableScopesBase.Select(s => new SentinelScope
    {
        Id = s.Id,
        Name = s.Name,
        DisplayName = s.DisplayName,
        Resources = s.Resources
    }).ToList();
    private List<string> _selectedScopeNames = new();
    private PermissionsModel _permissions = new();
    private EndpointsModel _endpoints = new();

    protected override async Task OnInitializedAsync()
    {
        // Haal het base type op om discriminator-conflict te voorkomen
        var appBase = await Db.Set<OpenIddictEntityFrameworkCoreApplication>()
                              .FirstOrDefaultAsync(x => x.ClientId == ClientId);

        if (appBase == null)
        {
            Logger.LogCritical("Edit attempt for {ClientId} Failed", ClientId);
            Snackbar.Add("Applicatie niet gevonden", Severity.Error);
            Navigation.NavigateTo("/");
            return;
        }

        // Zet naar je afgeleide model
        _model = new SentinelApplication
        {
            Id = appBase.Id,
            ClientId = appBase.ClientId,
            DisplayName = appBase.DisplayName,
            ClientType = appBase.ClientType,
            RedirectUris = appBase.RedirectUris,
            Permissions = appBase.Permissions,
            Properties = appBase.Properties,
         //   Version = appBase.Version
        };

        _availableScopesBase = await Db.Set<OpenIddictEntityFrameworkCoreScope>()
                                       .OrderBy(s => s.Name)
                                       .ToListAsync();

        if (!string.IsNullOrEmpty(_model.Permissions))
        {
            var permissions = _model.Permissions.Split(',', StringSplitOptions.RemoveEmptyEntries);
            foreach (var p in permissions)
            {
                if (p.StartsWith("scp:"))
                    _selectedScopeNames.Add(p.Substring(4));
                else if (p.StartsWith("gt:"))
                {
                    if (p == "gt:authorization_code") _permissions.AuthorizationCode = true;
                    if (p == "gt:refresh_token") _permissions.RefreshToken = true;
                    if (p == "gt:client_credentials") _permissions.ClientCredentials = true;
                }
                else if (p.StartsWith("ept:"))
                {
                    if (p == "ept:token") _endpoints.Token = true;
                    if (p == "ept:authorize") _endpoints.Authorize = true;
                    if (p == "ept:introspect") _endpoints.Introspect = true;
                    if (p == "ept:revocation") _endpoints.Revocation = true;
                    if (p == "ept:logout") _endpoints.Logout = true;
                    if (p == "ept:userinfo") _endpoints.UserInfo = true;
                }
            }
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/");
    }

    private async Task Save()
    {
        await _form!.Validate();
        if (!_form.IsValid) return;

        var selectedPermissions = new List<string>();
        if (_endpoints.Token) selectedPermissions.Add("ept:token");
        if (_endpoints.Authorize) selectedPermissions.Add("ept:authorize");
        if (_endpoints.Introspect) selectedPermissions.Add("ept:introspect");
        if (_endpoints.Revocation) selectedPermissions.Add("ept:revocation");
        if (_endpoints.Logout) selectedPermissions.Add("ept:logout");
        if (_endpoints.UserInfo) selectedPermissions.Add("ept:userinfo");
        if (_permissions.AuthorizationCode) selectedPermissions.Add("gt:authorization_code");
        if (_permissions.RefreshToken) selectedPermissions.Add("gt:refresh_token");
        if (_permissions.ClientCredentials) selectedPermissions.Add("gt:client_credentials");
        selectedPermissions.AddRange(_selectedScopeNames.Select(s => $"scp:{s}"));

        _model.Permissions = string.Join(",", selectedPermissions);

        // Update base type om EF Core happy te houden
        var entity = await Db.Set<OpenIddictEntityFrameworkCoreApplication>()
                             .FirstAsync(x => x.ClientId == _model.ClientId);

        entity.DisplayName = _model.DisplayName;
        entity.ClientType = _model.ClientType;
        entity.RedirectUris = _model.RedirectUris;
        entity.Permissions = _model.Permissions;

        await Db.SaveChangesAsync();

        Logger.LogDebug("Edit attempt for {ClientId} Completed", ClientId);
        Snackbar.Add("Applicatie succesvol bijgewerkt", Severity.Success);
        Navigation.NavigateTo("/");
    }

    private class PermissionsModel
    {
        public bool AuthorizationCode { get; set; }
        public bool RefreshToken { get; set; }
        public bool ClientCredentials { get; set; }
    }

    private class EndpointsModel
    {
        public bool Token { get; set; }
        public bool Authorize { get; set; }
        public bool Introspect { get; set; }
        public bool Revocation { get; set; }
        public bool Logout { get; set; }
        public bool UserInfo { get; set; }
    }
}
