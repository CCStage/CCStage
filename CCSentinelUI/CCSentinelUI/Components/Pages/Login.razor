@page "/login"
@using CCSentinelUI.Data
@using CCSentinelUI.Data.Contracts
@using CCSentinelUI.Components.Authentication
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext Db
@inject CustomAuthStateProvider authProvider
@inject NavigationManager nav
@inject ILogger<Login> Logger
@inject IHttpContextAccessor HttpContextAccessor
@inject ISnackbar Snackbar
@inject IJSRuntime JS


<MudPaper Class="pa-4 mx-auto mt-12" MaxWidth="400px">
    <MudText Typo="Typo.h5" Color="Color.Primary">Login</MudText>

    <EditForm Model="@loginModel" OnValidSubmit="@LoginFunction">

        <MudTextField @bind-Value="loginModel.Username" Label="Username" Variant="Variant.Outlined" FullWidth="true" />
        <MudTextField @bind-Value="loginModel.Password" Label="Password" Variant="Variant.Outlined" InputType="InputType.Password" FullWidth="true" />
        <MudButton Disabled="@_processing" ButtonType="ButtonType.Submit" Color="Color.Primary" Variant="Variant.Filled" FullWidth="true" Class="mt-4" StartIcon="@Icons.Material.Filled.Login">
            @if (_processing)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                <MudText Class="ms-2">Logging In</MudText>
            }
            else
            {
                <MudText>Login</MudText>
            }
        </MudButton>
    </EditForm>

    @if (!string.IsNullOrEmpty(_message))
    {
        <MudAlert Severity="Severity.Error">@_message</MudAlert>
    }
</MudPaper>

@code {
    private LoginModel loginModel = new();
    private string _message = "";
    private bool _processing = false;

    private async Task LoginFunction()
    {
        _message = "";
        _processing = true;
        StateHasChanged();

        var ip = HttpContextAccessor.HttpContext?.Connection?.RemoteIpAddress?.ToString() ?? "Unknown";
        Logger.LogDebug("Login attempt from IP {Ip} for user {Username}", ip, loginModel.Username);

        try
        {
            var user = await Db.Users.FirstOrDefaultAsync(u => u.UserName == loginModel.Username);

            if (user == null)
            {
                Fail("Unknown username");
                return;
            }

            var hasher = new PasswordHasher<SentinelUser>();
            var result = hasher.VerifyHashedPassword(user, user.PasswordHash, loginModel.Password);

            if (result == PasswordVerificationResult.Failed)
            {
                Fail("Invalid credentials");
                return;
            }

            var hasAdminRole = await (from ur in Db.UserRoles
                                      join r in Db.Roles on ur.RoleId equals r.Id
                                      where ur.UserId == user.Id && r.Name == "Admin"
                                      select ur).AnyAsync();

            if (!hasAdminRole)
            {
                Fail("User has no Admin permissions");
                return;
            }

            await JS.InvokeVoidAsync("loginUser");
            await authProvider.MarkUserAsAuthenticated();
            Logger.LogDebug("Login attempt for user {Username} from IP {Ip} Succeeded", loginModel.Username, ip);
            nav.NavigateTo("/", true);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unexpected login error for {Username}", loginModel.Username);
            Fail("Unexpected login error");
        }
        finally
        {
            _processing = false;
            StateHasChanged();
        }
    }

    private void Fail(string message)
    {
        Logger.LogWarning("Login failed for {Username}: {Message}", loginModel.Username, message);
        _message = message;
        Snackbar.Add(message, Severity.Error);
        _processing = false;
        StateHasChanged();
    }

    private class LoginModel
    {
        public string Username { get; set; } = "";
        public string Password { get; set; } = "";
    }
}
