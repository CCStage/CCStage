@page "/edit-role/{RoleId:guid}"
@using CCSentinelUI.Data
@using CCSentinelUI.Data.Contracts
@inject ApplicationDbContext Db
@inject NavigationManager Navigation
@inject ILogger<Login> Logger
@inject ISnackbar Snackbar
@using MudBlazor

<MudPaper Class="pa-6 mx-auto mt-6" Style="max-width: 900px;">
    <MudText Typo="Typo.h5" Class="mb-4">Edit rol</MudText>

    <MudGrid>
        <MudItem xs="3">
            <MudNavMenu Dense="true">
                <MudNavLink Match="NavLinkMatch.All" OnClick="@(() => _activeTab = "role")">Role</MudNavLink>
                <MudNavLink OnClick="@(() => _activeTab = "claims")">Claims</MudNavLink>
            </MudNavMenu>
        </MudItem>

        <MudItem xs="9">
            @if (_activeTab == "role")
            {
                <MudForm @ref="_form">
                    <MudGrid Spacing="3">
                        <MudItem xs="12">
                            <MudTextField Label="Rolnaam" @bind-Value="_role.Name" FullWidth="true" Required="true" />
                        </MudItem>
                        <MudItem>
                            <MudButton Color="Color.Primary" OnClick="Save" Class="mt-3">Opslaan</MudButton>
                            <MudButton Color="Color.Secondary" OnClick="Cancel" Class="mt-3 ml-2">Annuleren</MudButton>
                        </MudItem>
                    </MudGrid>
                </MudForm>
            }

            @if (_activeTab == "claims")
            {
                <RoleClaims RoleId="RoleId" />
            }
        </MudItem>
    </MudGrid>

    <MudText Color="Color.Error" Class="mt-2">@_errorMessage</MudText>
</MudPaper>

@code {
    [Parameter] public Guid RoleId { get; set; }

    private MudForm _form;
    private SentinelRole _role = new();
    private string _activeTab = "role";
    private string _errorMessage = "";

    protected override async Task OnInitializedAsync()
    {
        _role = await Db.Roles.FirstOrDefaultAsync(r => r.Id == RoleId)
                ?? throw new Exception("Rol niet gevonden");
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/roles");
    }

    private async Task Save()
    {
        await _form.Validate();
        if (!_form.IsValid) return;

        try
        {
            Db.Roles.Update(_role);
            await Db.SaveChangesAsync();

            Snackbar.Add("Rol succesvol bijgewerkt", Severity.Success);
            Logger.LogDebug("Rol bijgewerkt: {RoleName}", _role.Name);
            Navigation.NavigateTo("/roles");
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }
}
