@page "/users"
@using CCSentinelUI.Data
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Identity
@inject ApplicationDbContext Db
@inject NavigationManager Navigation
@inject ILogger<Login> Logger
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@using MudBlazor

<PageTitle>Users</PageTitle>

<MudPaper Class="p-4 mx-auto" MaxWidth="1000px" Elevation="3">
    <MudTable Items="@_users"
              Dense="true"
              Hover="true"
              Bordered="true"
              Striped="true"
              Filter="FilterFunc"
              @bind-SelectedItem="_selectedUser">

        <ToolBarContent>
            <MudText Typo="Typo.h6">Users Overview</MudText>
            <MudSpacer />

            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="@CreateUser">
                Create
            </MudButton>

            <MudButton Variant="Variant.Outlined" Color="Color.Info" StartIcon="@Icons.Material.Filled.Edit" Disabled="@(_selectedUser == null)" OnClick="@(() => EditUser(_selectedUser))">
                Edit
            </MudButton>

            <MudMenu Disabled="@(_selectedUser == null)" Color="Color.Warning" StartIcon="@Icons.Material.Filled.LockReset" Variant="Variant.Outlined" Label="Reset Password">
                <MudText Typo="Typo.subtitle2" Class="px-4 pt-2">Nieuw wachtwoord instellen:</MudText>
                <MudTextField @bind-Value="_newPassword" Label="Nieuw wachtwoord" InputType="InputType.Password" Dense="true" Class="px-4 mt-1" />
                <MudTextField @bind-Value="_confirmNewPassword" Label="Bevestig wachtwoord" InputType="InputType.Password" Dense="true" Class="px-4 mt-1 mb-2" />
                <MudDivider />
                <MudMenuItem OnClick="ResetPassword">
                    Opslaan
                </MudMenuItem>
            </MudMenu>

            <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete" Disabled="@(_selectedUser == null)" OnClick="@(() => DeleteUser(_selectedUser))">
                Delete
            </MudButton>

            <MudSpacer />
            <MudTextField @bind-Value="_search"
                          Placeholder="Zoek op UserName, Email of Name"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Class="mt-0" />
        </ToolBarContent>

        <HeaderContent>
            <MudTh>Id</MudTh>
            <MudTh>UserName</MudTh>
            <MudTh>FirstName</MudTh>
            <MudTh>LastName</MudTh>
            <MudTh>Email</MudTh>
            <MudTh>Locked Out</MudTh>
            <MudTh>Email Confirmed</MudTh>
        </HeaderContent>

        <RowTemplate>
            <MudTd DataLabel="Id">@context.Id</MudTd>
            <MudTd DataLabel="UserName">@context.UserName</MudTd>
            <MudTd DataLabel="FirstName">@context.FirstName</MudTd>
            <MudTd DataLabel="LastName">@context.LastName</MudTd>
            <MudTd DataLabel="Email">@context.Email</MudTd>
            <MudTd DataLabel="Locked Out">
                <MudCheckBox T="bool" Value="@context.LockoutEnabled" ReadOnly="true" />
            </MudTd>
            <MudTd DataLabel="Email Confirmed">
                <MudCheckBox T="bool" Value="@context.EmailConfirmed" ReadOnly="true" />
            </MudTd>
        </RowTemplate>

        <PagerContent>
            <MudTablePager />
        </PagerContent>
    </MudTable>

    <MudText Class="mt-2">Geselecteerd: @_selectedUser?.UserName</MudText>
</MudPaper>

@code {
    private string _search = string.Empty;
    private SentinelUser? _selectedUser;
    private List<SentinelUser> _users = new();

    // Voor wachtwoord reset popup
    private string _newPassword = "";
    private string _confirmNewPassword = "";

    protected override async Task OnInitializedAsync()
    {
        _users = await Db.Users
                         .OrderBy(u => u.UserName)
                         .AsNoTracking()
                         .ToListAsync();
    }

    private bool FilterFunc(SentinelUser user)
    {
        if (string.IsNullOrWhiteSpace(_search)) return true;

        return (user.UserName ?? "").Contains(_search, StringComparison.OrdinalIgnoreCase)
            || (user.Email ?? "").Contains(_search, StringComparison.OrdinalIgnoreCase)
            || (user.FirstName ?? "").Contains(_search, StringComparison.OrdinalIgnoreCase)
            || (user.LastName ?? "").Contains(_search, StringComparison.OrdinalIgnoreCase);
    }

    private async Task DeleteUser(SentinelUser user)
    {
        bool confirmed = await JS.InvokeAsync<bool>("confirm", $"Verwijder user '{user.UserName}'?");
        if (!confirmed) return;

        try
        {
            Db.Users.Remove(user);
            await Db.SaveChangesAsync();

            _users.Remove(user);
            Snackbar.Add("User verwijderd", Severity.Success);
            Logger.LogDebug("{UserName} deleted", user.UserName);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Fout bij verwijderen user {UserName}", user.UserName);
            Snackbar.Add("Fout bij verwijderen user", Severity.Error);
        }
    }

    private void EditUser(SentinelUser user)
    {
        Navigation.NavigateTo($"/edit-user/{user.Id}");
    }

    private void CreateUser()
    {
        Navigation.NavigateTo("/create_users");
    }

    private async Task ResetPassword()
    {
        if (_selectedUser == null)
        {
            Snackbar.Add("Selecteer eerst een user.", Severity.Warning);
            return;
        }

        if (string.IsNullOrWhiteSpace(_newPassword) || _newPassword != _confirmNewPassword)
        {
            Snackbar.Add("Wachtwoorden komen niet overeen of zijn leeg.", Severity.Error);
            return;
        }

        try
        {
            var passwordHasher = new PasswordHasher<SentinelUser>();
            _selectedUser.PasswordHash = passwordHasher.HashPassword(_selectedUser, _newPassword);

            Db.Users.Update(_selectedUser);
            await Db.SaveChangesAsync();

            Snackbar.Add($"Wachtwoord van {_selectedUser.UserName} succesvol gewijzigd.", Severity.Success);

            _newPassword = "";
            _confirmNewPassword = "";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Fout bij reset wachtwoord voor user {UserName}", _selectedUser.UserName);
            Snackbar.Add("Fout bij resetten wachtwoord.", Severity.Error);
        }
    }
}
