@page "/users"
@using CCSentinelUI.Data
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext Db
@inject NavigationManager Navigation
@inject ILogger<Login> Logger
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@using MudBlazor

<PageTitle>Users</PageTitle>

<MudPaper Class="p-4 mx-auto" MaxWidth="1000px" Elevation="3">
    <MudTable Items="@_users"
              Dense="true"
              Hover="true"
              Bordered="true"
              Striped="true"
              Filter="FilterFunc"
              @bind-SelectedItem="_selectedUser">

        <ToolBarContent>
            <MudText Typo="Typo.h6">Users Overview</MudText>
            <MudSpacer />
            <MudTextField @bind-Value="_search"
                          Placeholder="Zoek op UserName, Email of Name"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Class="mt-0" />
        </ToolBarContent>

        <HeaderContent>
            <MudTh>Id</MudTh>
            <MudTh>UserName</MudTh>
            <MudTh>Email</MudTh>
            <MudTh>FirstName</MudTh>
            <MudTh>Locked Out</MudTh>
            <MudTh>Email Confirmed</MudTh>
            <MudTh>Acties</MudTh>
        </HeaderContent>

        <RowTemplate>
            <MudTd DataLabel="Id">@context.Id</MudTd>
            <MudTd DataLabel="FirstName">@context.FirstName</MudTd>
            <MudTd DataLabel="UserName">@context.UserName</MudTd>
            <MudTd DataLabel="Email">@context.Email</MudTd>
            <MudTd DataLabel="Locked Out">
                <MudCheckBox T="bool" Disabled="true" @bind-Checked="@context.LockoutEnabled" />
            </MudTd>
            <MudTd DataLabel="Email Confirmed">
                <MudCheckBox T="bool" Disabled="true" @bind-Checked="@context.EmailConfirmed" />
            </MudTd>
            <MudTd DataLabel="Acties">
                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                               Color="Color.Info"
                               Size="Size.Small"
                               Variant="Variant.Outlined"
                               OnClick="@(() => EditUser(context))" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                               Color="Color.Error"
                               Size="Size.Small"
                               Variant="Variant.Outlined"
                               OnClick="@(() => DeleteUser(context))" />
            </MudTd>
        </RowTemplate>

        <PagerContent>
            <MudTablePager />
        </PagerContent>
    </MudTable>

    <MudText Class="mt-2">Geselecteerd: @_selectedUser?.UserName</MudText>
</MudPaper>

@code {
    private string _search = string.Empty;
    private User? _selectedUser;
    private List<User> _users = new();

    protected override async Task OnInitializedAsync()
    {
        _users = await Db.Users.OrderBy(u => u.UserName).ToListAsync();
    }

    private bool FilterFunc(User user)
    {
        if (string.IsNullOrWhiteSpace(_search)) return true;
        return (user.UserName ?? "").Contains(_search, StringComparison.OrdinalIgnoreCase)
            || (user.Email ?? "").Contains(_search, StringComparison.OrdinalIgnoreCase)
            || (user.FirstName ?? "").Contains(_search, StringComparison.OrdinalIgnoreCase);
    }

    private async Task DeleteUser(User user)
    {
        bool confirmed = await JS.InvokeAsync<bool>("confirm", $"Verwijder user '{user.UserName}'?");
        if (!confirmed) return;

        Db.Users.Remove(user);
        await Db.SaveChangesAsync();
        _users.Remove(user);
        Logger.LogDebug("{UserName} deleted", user.UserName);
        Snackbar.Add("User verwijderd", Severity.Error);
        StateHasChanged();
    }

    private void EditUser(User user)
    {
        Navigation.NavigateTo($"/edit-user/{user.Id}");
    }
}
