@page "/create-role"
@using CCSentinelUI.Data
@using CCSentinelUI.Data.Contracts
@inject ApplicationDbContext Db
@inject NavigationManager Navigation
@inject ILogger<Login> Logger
@inject ISnackbar Snackbar
@using MudBlazor

<MudPaper Class="pa-6 mx-auto mt-6" Style="max-width: 900px;">
    <MudText Typo="Typo.h5" Class="mb-4">Nieuwe rol aanmaken</MudText>

    <MudGrid>
        <MudItem xs="3">
            <MudNavMenu Dense="true">
                <MudNavLink Match="NavLinkMatch.All" OnClick="@(() => _activeTab = "role")">Role</MudNavLink>
                <MudNavLink OnClick="@(() => _activeTab = "claims")">Claims</MudNavLink>
            </MudNavMenu>
        </MudItem>

        <MudItem xs="9">
            @if (_activeTab == "role")
            {
                <MudForm @ref="_form">
                    <MudGrid Spacing="3">
                        <MudItem xs="12">
                            <MudTextField @bind-Value="_role.Name"
                                          Label="Rolnaam"
                                          FullWidth="true"
                                          Required="true"
                                          Immediate="true" />
                        </MudItem>
                        <MudItem>
                            <MudButton OnClick="Save" Variant="Variant.Filled" Color="Color.Primary" Class="mt-3">
                                Opslaan
                            </MudButton>
                            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Class="mt-3 ml-2"
                                       OnClick="@(() => Navigation.NavigateTo("/roles"))">
                                Annuleren
                            </MudButton>
                        </MudItem>
                    </MudGrid>
                </MudForm>
            }

            @if (_activeTab == "claims")
            {
                <RoleClaims RoleId="_role.Id" />
            }
        </MudItem>
    </MudGrid>

    <MudText Color="Color.Error" Class="mt-2">@_errorMessage</MudText>
</MudPaper>

@code {
    private MudForm _form;
    private SentinelRole _role = new();
    private string _activeTab = "role";
    private string _errorMessage = "";

    protected override void OnInitialized()
    {
        _role.Id = Guid.NewGuid();
    }

    private async Task Save()
    {
        await _form.Validate();
        if (!_form.IsValid)
        {
            _errorMessage = "Rolnaam is verplicht.";
            return;
        }

        try
        {
            if (await Db.Roles.AnyAsync(r => r.Name == _role.Name))
            {
                _errorMessage = "Rolnaam bestaat al";
                return;
            }

            Db.Roles.Add(_role);
            await Db.SaveChangesAsync();

            Logger.LogDebug("Rol '{RoleName}' aangemaakt", _role.Name);
            Snackbar.Add("Rol succesvol aangemaakt", Severity.Success);
            Navigation.NavigateTo("/roles");
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }
}
