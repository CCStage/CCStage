@page "/edit-user/{UserId:guid}"
@using CCSentinelUI.Data
@using CCSentinelUI.Data.Contracts
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Identity
@inject ApplicationDbContext Db
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@using MudBlazor

<MudPaper Class="pa-6 mx-auto mt-6" Style="max-width: 900px;">
    <MudText Typo="Typo.h5" Class="mb-4">Bewerk gebruiker</MudText>

    <MudForm @ref="_form">
        <MudGrid Spacing="3">
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_user.FirstName" Label="Voornaam" FullWidth="true" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_user.LastName" Label="Achternaam" FullWidth="true" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="_user.UserName" Label="Gebruikersnaam" FullWidth="true" Required="true" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="_user.Email" Label="E-mail" FullWidth="true" Required="true" />
            </MudItem>
            <MudItem xs="12">
                <MudCheckBox T="bool" @bind-Value="_user.EmailConfirmed" Label="E-mail bevestigd" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="_lockoutEndString" Label="Lockout einddatum (optioneel)" Placeholder="YYYY-MM-DD HH:mm" FullWidth="true" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="_password" Label="Nieuw wachtwoord" InputType="InputType.Password" FullWidth="true" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="_confirmPassword" Label="Bevestig nieuw wachtwoord" InputType="InputType.Password" FullWidth="true" />
            </MudItem>

            <MudItem xs="12">
                <MudText Typo="Typo.subtitle2" Class="mb-2">Scopes</MudText>
                <MudSelect T="string"
                           Label="Selecteer scopes"
                           SelectedValues="_selectedScopeNames"
                           SelectedValuesChanged="values => _selectedScopeNames = values.ToList()"
                           MultiSelection="true"
                           Dense="true"
                           Chip="true">
                    @foreach (var scope in _availableScopes)
                    {
                        <MudSelectItem Value="@scope.Name">@scope.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-3" OnClick="SaveUser">Opslaan</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Class="mt-3 ml-2" OnClick="@(() => Navigation.NavigateTo("/users"))">Annuleren</MudButton>
            </MudItem>
        </MudGrid>
    </MudForm>

    <MudText Color="Color.Error" Class="mt-2">@_errorMessage</MudText>
</MudPaper>

@code {
    [Parameter] public Guid UserId { get; set; }
    private MudForm _form;
    private SentinelUser _user = new();
    private string _password = "";
    private string _confirmPassword = "";
    private string _lockoutEndString = "";
    private string _errorMessage = "";
    private List<OpenIddictEntityFrameworkCoreScope> _availableScopes = new();
    private List<string> _selectedScopeNames = new();

    protected override async Task OnInitializedAsync()
    {
        _user = await Db.Users.FirstOrDefaultAsync(u => u.Id == UserId)
            ?? throw new Exception("Gebruiker niet gevonden");

        _lockoutEndString = _user.LockoutEnd?.ToString("yyyy-MM-dd HH:mm");

        _availableScopes = await Db.Set<OpenIddictEntityFrameworkCoreScope>()
                                   .OrderBy(s => s.Name)
                                   .ToListAsync();

        if (!string.IsNullOrEmpty(_user.Permissions))
        {
            _selectedScopeNames = _user.Permissions
                .Split(',', StringSplitOptions.RemoveEmptyEntries)
                .Where(p => p.StartsWith("scp:"))
                .Select(p => p.Substring(4))
                .ToList();
        }
    }

    private async Task SaveUser()
    {
        await _form.Validate();
        if (!_form.IsValid)
        {
            _errorMessage = "Vul alle verplichte velden correct in.";
            return;
        }

        if (!string.IsNullOrWhiteSpace(_lockoutEndString) && DateTime.TryParse(_lockoutEndString, out var parsedDate))
            _user.LockoutEnd = parsedDate;
        else
            _user.LockoutEnd = null;

        if (!string.IsNullOrWhiteSpace(_password))
        {
            if (_password != _confirmPassword)
            {
                _errorMessage = "Wachtwoord en bevestiging komen niet overeen.";
                return;
            }
            var hasher = new PasswordHasher<SentinelUser>();
            _user.PasswordHash = hasher.HashPassword(_user, _password);
        }

        _user.Permissions = string.Join(',', _selectedScopeNames.Select(s => $"scp:{s}"));

        Db.Users.Update(_user);
        await Db.SaveChangesAsync();

        Snackbar.Add("Gebruiker succesvol bijgewerkt", Severity.Success);
        Navigation.NavigateTo("/users");
    }
}
