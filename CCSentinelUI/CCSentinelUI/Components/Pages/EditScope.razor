@page "/edit-scope/{Id}"
@using CCSentinelUI.Data
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext Db
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject ILogger<Login> Logger
@using MudBlazor

<MudPaper Class="p-4 mx-auto" MaxWidth="600px" Elevation="3">
    <MudText Typo="Typo.h5">Edit scope</MudText>
    <MudForm @ref="_form" Class="mt-4">
        <MudTextField Label="Id" @bind-Value="_model.Id" Disabled="true" />
        <MudTextField Label="Display Name" @bind-Value="_model.DisplayName" Required="true" />
        <MudTextField Label="Name" @bind-Value="_model.Name" Required="true" />
        <MudTextField Label="Resources" @bind-Value="_model.Resources" />

        <MudButton Color="Color.Primary" OnClick="Save" Class="mt-3">Opslaan</MudButton>
        <MudButton Color="Color.Secondary" OnClick="Cancel" Class="mt-3 ml-2">Annuleren</MudButton>
    </MudForm>
</MudPaper>

@code {
    [Parameter] public string Id { get; set; } = string.Empty;

    private MudForm? _form;
    private SentinelScope _model = new();

    protected override async Task OnInitializedAsync()
    {
        // Base type ophalen
        var existing = await Db.Set<OpenIddictEntityFrameworkCoreScope>()
                               .FirstOrDefaultAsync(x => x.Id == Id);

        if (existing == null)
        {
            Logger.LogCritical("Edit attempt for {Id} failed: not found", Id);
            Snackbar.Add("Scope niet gevonden", Severity.Error);
            Navigation.NavigateTo("/scopes");
            return;
        }

        // Map naar afgeleid type voor UI
        _model = new SentinelScope
        {
            Id = existing.Id,
            DisplayName = existing.DisplayName,
            Name = existing.Name,
            Resources = existing.Resources
        };
    }

    private void Cancel()
    {
        Logger.LogDebug("Edit attempt for {Id} canceled", Id);
        Navigation.NavigateTo("/scopes");
    }

    private async Task Save()
    {
        await _form!.Validate();
        if (!_form.IsValid) return;

        var existing = await Db.Set<OpenIddictEntityFrameworkCoreScope>()
                               .FirstOrDefaultAsync(x => x.Id == _model.Id);

        if (existing == null)
        {
            Logger.LogCritical("Edit attempt for {Id} failed: not found", Id);
            Snackbar.Add("Scope niet gevonden", Severity.Error);
            Navigation.NavigateTo("/scopes");
            return;
        }

        existing.DisplayName = _model.DisplayName;
        existing.Name = _model.Name;
        existing.Resources = _model.Resources;

        try
        {
            await Db.SaveChangesAsync();
            Logger.LogDebug("Edit attempt for {Id} succeeded", Id);
            Snackbar.Add("Scope succesvol bijgewerkt", Severity.Success);
            Navigation.NavigateTo("/scopes");
        }
        catch (DbUpdateConcurrencyException)
        {
            Logger.LogCritical("Edit attempt for {Id} failed: concurrency issue", Id);
            Snackbar.Add("De scope is aangepast door iemand anders. Herlaad en probeer opnieuw.", Severity.Error);
        }
    }
}
