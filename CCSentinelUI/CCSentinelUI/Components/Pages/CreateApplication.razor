@page "/create"
@using CCSentinelUI.Data
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext Db
@inject NavigationManager Navigation
@inject ILogger<Login> Logger
@using MudBlazor

<MudPaper Class="pa-6 mx-auto mt-6" Style="max-width: 600px;">
    <MudText Typo="Typo.h5" Class="mb-4">Nieuwe applicatie aanmaken</MudText>

    <MudForm @ref="_form">
        <MudGrid Spacing="3">
            <MudItem xs="12">
                <MudTextField @bind-Value="_app.ClientId" Label="ClientId" FullWidth="true" Required="true" />
            </MudItem>

            <MudItem xs="12">
                <MudTextField @bind-Value="_app.DisplayName" Label="DisplayName" FullWidth="true" Required="true" />
            </MudItem>

            <MudItem xs="12">
                <MudTextField @bind-Value="_redirectUris" Label="RedirectUris (komma-gescheiden)" FullWidth="true" Required="true" />
            </MudItem>

            <MudItem xs="12">
                <MudSelect T="string" Label="Type's" @bind-Value="_app.ClientType">
                    @foreach (var type in _types)
                    {
                        <MudSelectItem Value="@type">@type</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12">
                <MudText Typo="Typo.subtitle2" Class="mb-2">Endpoints</MudText>
                <MudCheckBox T="bool" @bind-Value="_endpoints.Token" Label="token" />
                <MudCheckBox T="bool" @bind-Value="_endpoints.Authorize" Label="authorize" />
                <MudCheckBox T="bool" @bind-Value="_endpoints.Introspect" Label="introspect" />
                <MudCheckBox T="bool" @bind-Value="_endpoints.Revocation" Label="revocation" />
                <MudCheckBox T="bool" @bind-Value="_endpoints.Logout" Label="logout" />
                <MudCheckBox T="bool" @bind-Value="_endpoints.UserInfo" Label="userinfo" />
            </MudItem>

            <MudItem xs="12">
                <MudText Typo="Typo.subtitle2" Class="mb-2">Grant Types</MudText>
                <MudCheckBox T="bool" @bind-Value="_permissions.AuthorizationCode" Label="authorization_code" />
                <MudCheckBox T="bool" @bind-Value="_permissions.RefreshToken" Label="refresh_token" />
                <MudCheckBox T="bool" @bind-Value="_permissions.ClientCredentials" Label="client_credentials" />
            </MudItem>

            <MudItem xs="12">
                <MudText Typo="Typo.subtitle2" Class="mb-2">Scopes</MudText>
                <MudSelect T="string"
                           Label="Selecteer scopes"
                           SelectedValues="_selectedScopeNames"
                           SelectedValuesChanged="values => _selectedScopeNames = values.ToList()"
                           MultiSelection="true"
                           Dense="true"
                           Chip="true">
                    @foreach (var scope in _availableScopesBase)
                    {
                        <MudSelectItem Value="@scope.Name">@((scope.DisplayName ?? scope.Name))</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem>
                <MudButton OnClick="Save" Variant="Variant.Filled" Color="Color.Primary" Class="mt-3">Opslaan</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Class="mt-3 ml-2" OnClick="@(() => Navigation.NavigateTo("/"))">Annuleren</MudButton>
            </MudItem>
        </MudGrid>
    </MudForm>

    <MudText Color="Color.Error" Class="mt-2">@_errorMessage</MudText>
</MudPaper>

@code {
    private readonly string[] _types = { "confidental", "public" };
    private MudForm _form;
    private OpenIddictEntityFrameworkCoreApplication _app = new();
    private string _redirectUris = "";
    private PermissionsModel _permissions = new();
    private EndpointsModel _endpoints = new();
    private string _errorMessage = "";

    private List<OpenIddictEntityFrameworkCoreScope> _availableScopesBase = new();
    private List<string> _selectedScopeNames = new();

    protected override async Task OnInitializedAsync()
    {
        _app.Id = Guid.NewGuid().ToString();

        // gebruik dezelfde base type als edit page
        _availableScopesBase = await Db.Set<OpenIddictEntityFrameworkCoreScope>()
                                       .OrderBy(s => s.Name)
                                       .ToListAsync();
        StateHasChanged();
    }

    private async Task Save()
    {
        _errorMessage = "";
        try
        {
            _app.RedirectUris = _redirectUris;

            var selectedPermissions = new List<string>();

            if (_endpoints.Token) selectedPermissions.Add("ept:token");
            if (_endpoints.Authorize) selectedPermissions.Add("ept:authorize");
            if (_endpoints.Introspect) selectedPermissions.Add("ept:introspect");
            if (_endpoints.Revocation) selectedPermissions.Add("ept:revocation");
            if (_endpoints.Logout) selectedPermissions.Add("ept:logout");
            if (_endpoints.UserInfo) selectedPermissions.Add("ept:userinfo");

            if (_permissions.AuthorizationCode) selectedPermissions.Add("gt:authorization_code");
            if (_permissions.RefreshToken) selectedPermissions.Add("gt:refresh_token");
            if (_permissions.ClientCredentials) selectedPermissions.Add("gt:client_credentials");

            selectedPermissions.AddRange(_selectedScopeNames.Select(s => $"scp:{s}"));
            _app.Permissions = string.Join(",", selectedPermissions);

            Db.Set<OpenIddictEntityFrameworkCoreApplication>().Add(_app);
            await Db.SaveChangesAsync();

            Logger.LogDebug("Create attempt succeeded with {ClientId}", _app.ClientId);
            Navigation.NavigateTo("/");
        }
        catch (Exception ex)
        {
            Logger.LogDebug("Create attempt failed: {Message}", ex.Message);
            _errorMessage = ex.Message;
        }
    }

    private class PermissionsModel
    {
        public bool AuthorizationCode { get; set; }
        public bool RefreshToken { get; set; }
        public bool ClientCredentials { get; set; }
    }

    private class EndpointsModel
    {
        public bool Token { get; set; }
        public bool Authorize { get; set; }
        public bool Introspect { get; set; }
        public bool Revocation { get; set; }
        public bool Logout { get; set; }
        public bool UserInfo { get; set; }
    }
}
