@page "/create_users"
@using CCSentinelUI.Data
@using CCSentinelUI.Data.Contracts
@inject ApplicationDbContext Db
@inject NavigationManager Navigation
@inject ILogger<Login> Logger
@inject ISnackbar Snackbar
@using Microsoft.AspNetCore.Identity
@using MudBlazor

<MudPaper Class="pa-6 mx-auto mt-6" Style="max-width: 900px;">
    <MudText Typo="Typo.h5" Class="mb-4">Nieuwe user aanmaken</MudText>

    <MudGrid>
        <MudItem xs="3">
            <MudNavMenu Dense="true">
                <MudNavLink Match="NavLinkMatch.All" OnClick="@(() => _activeTab = "user")"> User </MudNavLink>
                <MudNavLink OnClick="@(() => _activeTab = "claims")"> Claims </MudNavLink>
                <MudNavLink OnClick="@(() => _activeTab = "roles")"> Rollen </MudNavLink>
            </MudNavMenu>
        </MudItem>

        <MudItem xs="9">
            @if (_activeTab == "user")
            {
                <MudForm @ref="_form">
                    <MudGrid Spacing="3">
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="_user.FirstName" Label="Voornaam" FullWidth="true" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="_user.LastName" Label="Achternaam" FullWidth="true" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudTextField @bind-Value="_user.UserName" Label="Gebruikersnaam" FullWidth="true" Required="true" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudTextField @bind-Value="_password" Label="Wachtwoord" InputType="InputType.Password" FullWidth="true" Required="true" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudTextField @bind-Value="_confirmPassword" Label="Bevestig wachtwoord" InputType="InputType.Password" FullWidth="true" Required="true" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudTextField @bind-Value="_user.Email" Label="E-mail" FullWidth="true" Required="true" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudCheckBox T="bool" @bind-Value="_user.EmailConfirmed" Label="E-mail bevestigd" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudTextField @bind-Value="_lockoutEndString" Label="Lockout einddatum (optioneel)" Placeholder="YYYY-MM-DD HH:mm" FullWidth="true" />
                        </MudItem>
                        <MudItem>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-3" OnClick="SaveUser">Opslaan</MudButton>
                            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Class="mt-3 ml-2" OnClick="@(() => Navigation.NavigateTo("/users"))">Annuleren</MudButton>
                        </MudItem>
                    </MudGrid>
                </MudForm>
            }

            @if (_activeTab == "claims")
            {
                <UserClaims UserId="_user.Id" />
            }

            @if (_activeTab == "roles")
            {
                <UserRoles UserId="_user.Id" />
            }
        </MudItem>
    </MudGrid>

    <MudText Color="Color.Error" Class="mt-2">@_errorMessage</MudText>
</MudPaper>

@code {
    private MudForm _form;
    private SentinelUser _user = new();
    private string _errorMessage = "";
    private string _password = "";
    private string _confirmPassword = "";
    private string? _lockoutEndString;
    private string _activeTab = "user";

    protected override async Task OnInitializedAsync()
    {
        _user.Id = Guid.NewGuid();
    }

    private async Task SaveUser()
    {
        await _form.Validate();
        if (!_form.IsValid)
        {
            _errorMessage = "Vul verplichte velden in.";
            return;
        }

        if (_password != _confirmPassword)
        {
            _errorMessage = "Wachtwoorden komen niet overeen.";
            return;
        }

        _errorMessage = "";
        try
        {
            if (!string.IsNullOrWhiteSpace(_lockoutEndString) && DateTime.TryParse(_lockoutEndString, out var parsedDate))
                _user.LockoutEnd = parsedDate;
            else
                _user.LockoutEnd = null;

            var hasher = new PasswordHasher<SentinelUser>();
            _user.PasswordHash = hasher.HashPassword(_user, _password);

            Db.Users.Add(_user);
            await Db.SaveChangesAsync();

            Snackbar.Add("Gebruiker succesvol aangemaakt", Severity.Success);
            Logger.LogDebug("Gebruiker aangemaakt met ID {Id}", _user.Id);
            Navigation.NavigateTo("/users");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Fout bij aanmaken gebruiker");
            _errorMessage = ex.Message;
        }
    }
}
