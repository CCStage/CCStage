@page "/create_users"
@using CCSentinelUI.Data
@inject ApplicationDbContext Db
@inject NavigationManager Navigation
@inject ILogger<Login> Logger
@inject ISnackbar Snackbar
@using MudBlazor

<MudPaper Class="pa-6 mx-auto mt-6" Style="max-width: 600px;">
    <MudText Typo="Typo.h5" Class="mb-4">Nieuwe gebruiker aanmaken</MudText>

    <MudForm @ref="_form" OnValidSubmit="HandleValidSubmit">
        <MudGrid Spacing="3">

            <MudItem xs="12">
                <MudTextField @bind-Value="_user.UserName" Label="Gebruikersnaam" FullWidth="true" Required="true" />
            </MudItem>

            <MudItem xs="12">
                <MudTextField @bind-Value="_user.Email" Label="E-mail" FullWidth="true" Required="true" />
            </MudItem>

            <MudItem xs="12">
                <MudTextField @bind-Value="_user.FirstName" Label="Voornaam" FullWidth="true" />
            </MudItem>

            <MudItem xs="12">
                <MudCheckBox T="bool" @bind-Checked="_user.LockoutEnabled" Label="Geblokkeerd" />
            </MudItem>

            <MudItem xs="12">
                <MudCheckBox T="bool" @bind-Checked="_user.EmailConfirmed" Label="E-mail bevestigd" />
            </MudItem>

            <MudItem xs="12">
                <MudButton Type="Submit" Variant="Variant.Filled" Color="Color.Primary" Class="mt-3">Opslaan</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Class="mt-3 ml-2" OnClick="@(() => Navigation.NavigateTo("/users"))">Annuleren</MudButton>
            </MudItem>
        </MudGrid>
    </MudForm>

    <MudText Color="Color.Error" Class="mt-2">@_errorMessage</MudText>
</MudPaper>

@code {
    private MudForm _form;
    private User _user = new();
    private string _errorMessage = "";

    protected override void OnInitialized()
    {
        _user.Id = Guid.NewGuid();
    }

    private async Task HandleValidSubmit()
    {
        _errorMessage = "";
        try
        {
            Db.Users.Add(_user);
            await Db.SaveChangesAsync();
            Snackbar.Add("Gebruiker succesvol aangemaakt", Severity.Success);
            Logger.LogDebug("Gebruiker aangemaakt met ID {Id}", _user.Id);
            Navigation.NavigateTo("/users");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Fout bij aanmaken gebruiker");
            _errorMessage = ex.Message;
        }
    }
}
