@using CCSentinelUI_.Components.Authentication
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject CustomAuthStateProvider AuthStateProvider
@rendermode InteractiveServer

<div class="top-row ps-3 navbar navbar-dark" style="background-color:#fff; height:65px;">
    <div class="container-fluid d-flex align-items-center" style="height:100%;">
        <MudImage Src="images/cclaw_logo2.jpg" Alt="Logo" Style="height:100%; width:auto; object-fit:contain;" />
    </div>
</div>


<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" color="White" style="background-color:#f58f25" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/">
                <span class="bi bi-house-door-fill-nav-menu"></span> Home
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="counter">
                <span class="bi bi-plus-square-fill-nav-menu"></span> Counter
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="weather">
                <span class="bi bi-list-nested-nav-menu"></span> Weather
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <MudButton OnClick="@Logout" Color="Color.Error" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Logout">

                Logout
            </MudButton>
        </div>
    </nav>
</div>

@code {
    private async Task Logout()
    {
        await JS.InvokeVoidAsync("fetch", "/api/logout", new
        {
            method = "POST",
            credentials = "include"
        });

        await AuthStateProvider.MarkUserAsLoggedOut();
        Nav.NavigateTo("/login", forceLoad: true);

    }
}
