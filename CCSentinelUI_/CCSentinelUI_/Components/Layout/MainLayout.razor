@using CCSentinelUI_.Components.Authentication
@inherits LayoutComponentBase
@inject CustomAuthStateProvider authStateProvider
@* Required *@
<MudThemeProvider />
<MudPopoverProvider />

@* Needed for dialogs *@
<MudDialogProvider />

@* Needed for snackbars *@
<MudSnackbarProvider />

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <MudAppBar Style="background-color: #f58f25" Fixed="false">
            <MudBadge Icon="@Icons.Material.Filled.LockOpen" Color="Color.Success" Overlap="true" Bordered="true" Class="mx-6 my-4">
                <MudButton OnClick="SecurityCheck" Color="Color.Success" Variant="Variant.Filled" DropShadow="false">Security Clearance</MudButton>
            </MudBadge>
            <MudSpacer />
            <MudButtonGroup Style="background-color: #f58f25">
                <MudIconButton href="https://visualstudio.microsoft.com/" target="_blank" Icon="@Icons.Custom.Brands.MicrosoftVisualStudio" Color="Color.Inherit" />
                <MudIconButton href="https://learn.microsoft.com/aspnet/core/" target="_blank" Icon="@Icons.Custom.Brands.Microsoft" Color="Color.Inherit" />
                <MudIconButton href="https://mudblazor.com/" target="_blank" Icon="@Icons.Custom.Brands.MudBlazor" Color="Color.Inherit" />
            </MudButtonGroup>
        </MudAppBar>
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
<footer>

    <MudAppBar Style="background-color: #5097a4" Fixed="false">
        <MudSpacer />

    </MudAppBar>

</footer>

@code{
    public void SecurityCheck()
    {
        Snackbar.Add("You have Clearance", Severity.Success);
    }
}
