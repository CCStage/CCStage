@page "/"
@using CCSentinelUI_.Data
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext Db

<PageTitle>OpenId Applications</PageTitle>

<MudPaper Class="p-4 mx-auto" MaxWidth="1200px" Elevation="3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3>OpenId Applications</h3>
        <MudTextField @bind-Value="_search"
                      Placeholder="Zoek op Id of DisplayName"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Immediate="true"
                      OnBlur="Reload" />

    </div>

    <MudTable T="OpenIdApplication"
              Items="_apps"
              Hover="true"
              Dense="true"
              Bordered="true"
              Striped="true">

        <HeaderContent>
            <MudTh>Id</MudTh>
            <MudTh>Type</MudTh>
            <MudTh>Display Name</MudTh>
            <MudTh>Permissions</MudTh>
            <MudTh>Properties</MudTh>
        </HeaderContent>

        <RowTemplate>
            <MudTd>@context.ClientId</MudTd>
            <MudTd>@context.ClientType</MudTd>
            <MudTd>@context.DisplayName</MudTd>
            <MudTd>@context.Permissions</MudTd>
            <MudTd>@context.Properties</MudTd>
        </RowTemplate>
    </MudTable>
</MudPaper>

@code {
    private string? _search;
    private List<OpenIdApplication> _apps = new();

    protected override async Task OnInitializedAsync() => await Reload();

    private async Task Reload()
    {
        var query = Db.OpenIddictApplications.AsQueryable();

        if (!string.IsNullOrWhiteSpace(_search))
        {
            query = query.Where(x =>
                x.DisplayName!.Contains(_search) ||
                x.ClientId.ToString().Contains(_search));
        }

        _apps = await query.Take(100).ToListAsync();
    }
}
