@page "/edit-application/{ClientId}"
@using CCSentinelUI_.Data
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext Db
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@using MudBlazor

<MudPaper Class="p-4 mx-auto" MaxWidth="600px" Elevation="3">
    <MudText Typo="Typo.h5">Bewerk applicatie</MudText>
    <MudForm @ref="_form" Class="mt-4">
        <MudTextField Label="ClientId" @bind-Value="_model.ClientId" Disabled="true" />
        <MudTextField Label="Display Name" @bind-Value="_model.DisplayName" Required="true" />
        <MudTextField Label="Permissions" @bind-Value="_model.Permissions" />
        <MudTextField Label="RedirectUris" @bind-Value="_model.RedirectUris" />
        <input type="hidden" @bind="_model.Version" />
        <MudButton Color="Color.Primary" OnClick="Save" Class="mt-3">Opslaan</MudButton>
        <MudButton Color="Color.Secondary" OnClick="Cancel" Class="mt-3 ml-2">Annuleren</MudButton>
    </MudForm>
</MudPaper>

@code {
    [Parameter] public string ClientId { get; set; } = string.Empty;
    private MudForm? _form;
    private OpenIdApplication _model = new();

    protected override async Task OnInitializedAsync()
    {
        var existing = await Db.OpenIddictApplications.FirstOrDefaultAsync(x => x.ClientId == ClientId);
        if (existing == null)
        {
            Snackbar.Add("Applicatie niet gevonden", Severity.Error);
            Navigation.NavigateTo("/");
            return;
        }
        _model = new OpenIdApplication
        {
            ClientId = existing.ClientId,
            DisplayName = existing.DisplayName,
            Permissions = existing.Permissions,
            RedirectUris = existing.RedirectUris,
            Version = existing.Version
        };
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/");
    }

    private async Task Save()
    {
        await _form!.Validate();
        if (!_form.IsValid) return;

        var existing = await Db.OpenIddictApplications.FirstOrDefaultAsync(x => x.ClientId == _model.ClientId);
        if (existing == null)
        {
            Snackbar.Add("Applicatie niet gevonden", Severity.Error);
            Navigation.NavigateTo("/");
            return;
        }

        existing.DisplayName = _model.DisplayName;
        existing.Permissions = _model.Permissions;
        existing.RedirectUris = _model.RedirectUris;
        existing.Version = _model.Version;

        try
        {
            await Db.SaveChangesAsync();
            Snackbar.Add("Applicatie succesvol bijgewerkt", Severity.Success);
            Navigation.NavigateTo("/");
        }
        catch (DbUpdateConcurrencyException)
        {
            Snackbar.Add("De applicatie is aangepast door iemand anders. Herlaad en probeer opnieuw.", Severity.Error);
        }
    }
}
